{
  "expo": {
    "name": "Joykin",
    "slug": "Joykin",
    "scheme": "joykin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F5F1"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8F5F1"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Joykin ใช้ตำแหน่งเพื่อแสดงร้านและเมนูใกล้คุณ รวมถึงปักหมุดร้านของเมนูที่คุณบันทึก"
        }
      ]
    ]
  }
}
